# PT-Forward 环境配置模板
# 使用方法：cp .env.example .env && 填入真实值
# ⚠️ .env 不入库（.gitignore 已覆盖）——绝不提交真实凭据

# ── PT-Forward 面板认证 ──
PTF_HOST=localhost
PTF_PORT=8765
PTF_USER=<面板用户名>
PTF_PASS=<面板密码>

# ── SSH / 部署 ──
SSH_USER=<SSH 用户>
SSH_KEY=<SSH 私钥路径·如 ~/[REDACTED-ssh_path]>

# ── 网络 ──
PROXY=<代理地址·如 http://10.0.2.5:7897>

# ── 环境主机（Agent 读取用·按需增加）──
DEV_HOST=<开发机 IP·Agent 唯一可操作>
# PROD_HOST_243=<243 IP>
# PROD_HOST_249=<249 IP>

# ── CookieCloud（docs/36 消费）──
# CC_URL=<CookieCloud 服务地址>
# CC_UUID=<UUID>
# CC_PASSWORD=<密码>

# ── 加密密钥（integration-test 调试工具用·来源=config.yaml 的 security.encryption_key）──
# ENCRYPTION_KEY=<config.yaml 里的 encryption_key 值>

# ── 调试工具 DB 路径（gen_seed/integration-test/verify-pieces-hash·空=fallback 相对路径 data/pt-forward.db）──
# PTF_DB=/absolute/path/to/pt-forward.db
# ── 幸运站 DryRun 审计工具用户名（tools/luckpt-audit）──
# LUCK_USERNAME=<幸运站用户名>
